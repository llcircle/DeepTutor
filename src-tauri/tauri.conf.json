{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepTutor",
  "version": "1.7.0",
  "identifier": "ai.deeptutor.desktop",
  "build": {
    "frontendDist": "resources/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DeepTutor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "category": "Education",
    "shortDescription": "Agent-native intelligent learning companion",
    "longDescription": "DeepTutor portable desktop application powered by a standalone Rust backend.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/web/**/*"
    ]
  }
}
